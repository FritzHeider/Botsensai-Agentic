    btn.className = 'mc-btn resume-btn';
  } else {
    btn.innerHTML = '<span class="icon">⏸</span> Pause Engine';
    btn.className = 'mc-btn pause-btn';
  }
}

async function checkEngineStatus() {
  try {
    const res = await fetch('/api/v1/system/actions/status');
    if (res.ok) {
      const data = await safeFetchJson(res);
      isEnginePaused = !!data.engine_paused;
      updatePauseButton();
    }
  } catch (e) {}
}
