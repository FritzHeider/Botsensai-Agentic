async function togglePause() {
  const action = isEnginePaused ? 'resume' : 'pause';
  if (!confirm(`Are you sure you want to ${action.toUpperCase()} the automated scoring and sweeping engine?`)) return;

  try {
    const res = await fetch(`/api/v1/system/actions/${action}`, { method: 'POST' });
    const data = await safeFetchJson(res);
    if (res.ok) {
      isEnginePaused = (action === 'pause');
      updatePauseButton();
    } else {
      alert(`Failed to ${action} engine: ${data.detail || 'Request failed'}`);
    }
  } catch (err) {
    alert(`Failed to ${action} engine: ${err.message}`);
  }
}

