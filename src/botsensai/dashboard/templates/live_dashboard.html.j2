async function executeBacktest() {
  const btn = document.getElementById('btn-run-backtest');
  const resContainer = document.getElementById('backtest-results-container');
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<span class="action-spinner"></span> Simulating Execution...';
  }
  resContainer.style.display = 'block';
  resContainer.innerHTML = '<div style="padding:20px; text-align:center;" class="dim"><span class="action-spinner"></span> Replaying historical market tapes through composite scoring, risk limits & sandwich fill simulator...</div>';

  try {
    const payload = {
      lookback_days: parseFloat(document.getElementById('bt-days').value) || 7.0,
      capital_sol: parseFloat(document.getElementById('bt-capital').value) || 10.0,
      min_score: parseFloat(document.getElementById('bt-minscore').value) || 0.65,
      universe: parseInt(document.getElementById('bt-universe').value) || 60,
      baselines: document.getElementById('bt-baselines').checked,
      synthetic: document.getElementById('bt-synthetic').checked,
    };

    const res = await fetch('/api/v1/backtest/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await safeFetchJson(res);
    if (!res.ok) {
      resContainer.innerHTML = `<p style="color:var(--alarm);">Backtest Failed: ${data.detail || 'Execution error'}</p>`;
      return;
    }

    const s = data.summary || {};
    const trades = data.trades || [];
    const winRatePct = (s.win_rate !== undefined ? (s.win_rate * 100).toFixed(1) : '0.0') + '%';
    const returnPct = (s.total_return !== undefined ? (s.total_return * 100).toFixed(1) : '0.0') + '%';
    const sharpeVal = s.sharpe !== undefined ? Number(s.sharpe).toFixed(2) : 'N/A';
    const maxDdPct = (s.max_drawdown !== undefined ? (s.max_drawdown * 100).toFixed(1) : '0.0') + '%';
    const realizedSol = s.realized_pnl_native !== undefined ? Number(s.realized_pnl_native).toFixed(4) + ' SOL' : '0.0000 SOL';
    const expectancy = s.expectancy_native !== undefined ? Number(s.expectancy_native).toFixed(4) + ' SOL' : '0.0000 SOL';

    let outHtml = `
      <div style="border-top:1px solid var(--line); padding-top:14px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <b style="color:var(--accent); font-size:14px;">Walk-Forward Results &middot; ${data.duration_seconds}s</b>
          <span class="dim" style="font-size:11px;">${data.synthetic ? '⚠️ SYNTHETIC COHORT' : '✓ STORE REPLAY'} (${data.token_count} tokens)</span>
        </div>

        <div class="kpi-card-grid">
          <div class="kpi-card">
            <div class="val" style="color:${s.total_return >= 0 ? 'var(--ok)' : 'var(--alarm)'};">${returnPct}</div>
            <div class="lbl">Total Return</div>
          </div>
          <div class="kpi-card">
            <div class="val" style="color:var(--ok);">${winRatePct}</div>
            <div class="lbl">Win Rate</div>
          </div>
          <div class="kpi-card">
            <div class="val">${sharpeVal}</div>
            <div class="lbl">Sharpe Ratio</div>
          </div>
          <div class="kpi-card">
            <div class="val" style="color:var(--alarm);">${maxDdPct}</div>
            <div class="lbl">Max Drawdown</div>
          </div>
          <div class="kpi-card">
            <div class="val" style="color:${s.realized_pnl_native >= 0 ? 'var(--ok)' : 'var(--alarm)'};">${realizedSol}</div>
            <div class="lbl">Realized PnL</div>
          </div>
          <div class="kpi-card">
            <div class="val">${expectancy}</div>
            <div class="lbl">Expectancy</div>
          </div>
        </div>

        ${data.baselines ? `
          <div style="background:#11151c; border:1px solid var(--line); border-radius:6px; padding:10px; margin:10px 0; font-size:11px;">
            <b>Null-Hypothesis Baselines Comparison:</b>
            <pre style="margin-top:6px; font-size:11px;">${JSON.stringify(data.baselines, null, 2)}</pre>
          </div>
        ` : ''}

        <div style="margin-top:12px;">
          <div style="font-size:12px; font-weight:600; margin-bottom:6px; color:var(--dim);">REPLAYED TRADES (${trades.length})</div>
          <div style="max-height:220px; overflow-y:auto; border:1px solid var(--line); border-radius:6px;">
            <table class="pos-table">
              <thead>
                <tr>
                  <th>Token</th>
                  <th>Entry Score</th>
                  <th>Multiple</th>
                  <th>PnL (SOL)</th>
                  <th>Exit Reason</th>
                  <th>Hold Time</th>
                </tr>
              </thead>
              <tbody>
                ${trades.length ? trades.map(t => `
                  <tr>
                    <td><b>${t.symbol || '?'}</b> <span class="dim" style="font-size:10px;">${(t.token || '').split(':')[1] || ''}</span></td>
                    <td>${(t.score || 0).toFixed(3)}</td>
                    <td style="color:${(t.multiple || 1) >= 1 ? 'var(--ok)' : 'var(--alarm)'}; font-weight:700;">${(t.multiple || 1).toFixed(2)}x</td>
                    <td style="color:${(t.pnl_native || 0) >= 0 ? 'var(--ok)' : 'var(--alarm)'}; font-weight:600;">${(t.pnl_native || 0) >= 0 ? '+' : ''}${(t.pnl_native || 0).toFixed(4)}</td>
                    <td><span class="dim">${t.exit_reason || 'exit'}</span></td>
                    <td class="dim">${Math.round(t.hold_seconds || 0)}s</td>
