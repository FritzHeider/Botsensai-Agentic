          <div class="val" style="color:${data.unrealized_pnl_native >= 0 ? 'var(--ok)' : 'var(--alarm)'};">${data.unrealized_pnl_native >= 0 ? '+' : ''}${unPnl} SOL</div>
          <div class="lbl">Unrealized PnL</div>
        </div>
        <div class="kpi-card">
          <div class="val" style="color:${data.realized_pnl_native >= 0 ? 'var(--ok)' : 'var(--alarm)'};">${data.realized_pnl_native >= 0 ? '+' : ''}${rePnl} SOL</div>
          <div class="lbl">Realized PnL</div>
        </div>
        <div class="kpi-card">
          <div class="val" style="color:${data.total_return >= 0 ? 'var(--ok)' : 'var(--alarm)'};">${retPct}</div>
          <div class="lbl">Total Return</div>
        </div>
        <div class="kpi-card">
          <div class="val">${winRate}</div>
          <div class="lbl">Win Rate (${data.closed_trades_count || 0})</div>
        </div>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin:16px 0 6px 0;">
        <b style="font-size:13px;">ACTIVE OPEN POSITIONS (${openPos.length})</b>
        <div style="display:flex; gap:8px;">
          <button class="btn-sm" onclick="openPapertradeModal()" title="Refresh positions">⟳ Refresh</button>
          ${openPos.length ? `<button class="btn-sm btn-close-pos" onclick="liquidateAllPositions()">🚨 Liquidate All (${openPos.length})</button>` : ''}
          <button class="btn-sm" style="border-color:var(--line); color:var(--dim);" onclick="resetPaperPortfolio()">Reset Account</button>
        </div>
      </div>

      <div style="max-height:220px; overflow-y:auto; border:1px solid var(--line); border-radius:6px; margin-bottom:16px;">
        <table class="pos-table">
          <thead>
            <tr>
              <th>Token</th>
              <th>Amount</th>
              <th>Cost Basis</th>
              <th>Current Val</th>
              <th>PnL / Mult</th>
              <th>Age</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            ${openPos.length ? openPos.map(p => `
              <tr>
                <td>
                  <b>${p.symbol || '?'}</b>
                  <div class="dim" style="font-size:10px;">${(p.mint || '').slice(0, 10)}...</div>
                </td>
                <td>${Number(p.amount_token).toLocaleString()}</td>
                <td>${Number(p.cost_basis_native).toFixed(4)} SOL</td>
                <td>${Number(p.current_value_native).toFixed(4)} SOL</td>
                <td>
                  <span style="color:${p.unrealized_pnl_native >= 0 ? 'var(--ok)' : 'var(--alarm)'}; font-weight:700;">
                    ${p.unrealized_pnl_native >= 0 ? '+' : ''}${Number(p.unrealized_pnl_native).toFixed(4)} SOL
                    (${Number(p.multiple).toFixed(2)}x)
                  </span>
                </td>
                <td class="dim">${Math.round(p.age_seconds || 0)}s</td>
                <td>
                  <button class="btn-sm btn-close-pos" onclick="closePosition('${p.token_key}')">Close</button>
                </td>
              </tr>
            `).join('') : '<tr><td colspan="7" class="dim" style="text-align:center; padding:16px;">No open paper positions held. Use [⚡ Trigger Sweep] to evaluate and open new candidates.</td></tr>'}
          </tbody>
        </table>
      </div>

      <b style="font-size:13px; margin-top:10px; display:block;">RECENT CLOSED TRADES</b>
      <div style="max-height:160px; overflow-y:auto; border:1px solid var(--line); border-radius:6px; margin-top:6px;">
        <table class="pos-table">
          <thead>
            <tr>
              <th>Token</th>
              <th>Cost Basis</th>
              <th>Exit Px</th>
              <th>Realized PnL</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            ${closedPos.length ? closedPos.map(c => `
              <tr>
                <td><b>${c.symbol || '?'}</b> <span class="dim" style="font-size:10px;">${(c.mint || '').slice(0, 8)}</span></td>
                <td>${Number(c.cost_basis_native).toFixed(4)} SOL</td>
                <td>${Number(c.last_price_native).toFixed(8)}</td>
                <td style="color:${c.realized_pnl_native >= 0 ? 'var(--ok)' : 'var(--alarm)'}; font-weight:700;">
                  ${c.realized_pnl_native >= 0 ? '+' : ''}${Number(c.realized_pnl_native).toFixed(4)} SOL
                </td>
                <td><span class="dim">${c.exit_reason || 'exit'}</span></td>
              </tr>
            `).join('') : '<tr><td colspan="5" class="dim" style="text-align:center; padding:12px;">No closed trades recorded yet.</td></tr>'}
          </tbody>
        </table>
      </div>
    `;

    showActionModal('💼 Paper Trading Portfolio & Positions', html, false, 'modal-xl');
    updateBadges();
  } catch (err) {
    showActionModal('Portfolio Error', `<p style="color:var(--alarm);">Network error: ${err.message}</p>`, false, 'modal-lg');
  }
}

async function closePosition(tokenKey) {
  if (!confirm(`Close paper position for ${tokenKey}?`)) return;
  try {
    const res = await fetch('/api/v1/papertrade/close', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token_key: tokenKey, reason: 'operator_manual_close' }),
    });
    const data = await safeFetchJson(res);
    if (res.ok) {
      openPapertradeModal();
    } else {
      alert(`Failed to close position: ${data.detail || ''}`);
    }
  } catch (err) {
    alert(`Error: ${err.message}`);
  }
}

async function liquidateAllPositions() {
  if (!confirm('EMERGENCY: Are you sure you want to close ALL open paper trading positions?')) return;
  try {
    const res = await fetch('/api/v1/papertrade/close_all', { method: 'POST' });
    const data = await safeFetchJson(res);
    if (res.ok) {
      alert(`Liquidated ${data.liquidated_count} positions.`);
      openPapertradeModal();
    } else {
      alert(`Failed to liquidate: ${data.detail || ''}`);
    }
  } catch (err) {
    alert(`Error: ${err.message}`);
  }
}

async function resetPaperPortfolio() {
  if (!confirm('Are you sure you want to reset all paper trading positions and history?')) return;
  try {
    const res = await fetch('/api/v1/papertrade/reset', { method: 'POST' });
    const data = await safeFetchJson(res);
    if (res.ok) {
      openPapertradeModal();
    }
  } catch (err) {
    alert(`Error: ${err.message}`);
  }
}

// --- Sniper Info & Outbox --- //
async function openSniperModal() {
  showActionModal('🎯 Sniper Info & Outbox', '<p class="dim"><span class="action-spinner"></span> Loading sniper telemetry & outbox signals...</p>', true, 'modal-xl');
  try {
    const [statusRes, signalsRes] = await Promise.all([
      fetch('/api/v1/sniper/status'),
      fetch('/api/v1/sniper/signals?limit=30'),
    ]);
    const statusData = await safeFetchJson(statusRes);
    const signalsData = await safeFetchJson(signalsRes);

    const signals = Array.isArray(signalsData) ? signalsData : [];
    const invariants = statusData.safety_invariants || {};
    const execution = statusData.execution || {};

    let html = `
      <div style="display:flex; flex-direction:column; gap:16px;">
        <div class="kpi-card-grid">
          <div class="kpi-card">
            <div class="val" style="color:var(--ok); font-size:14px;">${statusData.mode || 'PAPER'}</div>
            <div class="lbl">Execution Mode</div>
          </div>
          <div class="kpi-card">
            <div class="val" style="color:var(--ok); font-size:14px;">VERIFIED SAFE</div>
            <div class="lbl">Zero-Signing Invariant</div>
          </div>
          <div class="kpi-card">
            <div class="val">${invariants.canary_max_sol || 0.05} SOL</div>
            <div class="lbl">Max Canary Size</div>
          </div>
          <div class="kpi-card">
            <div class="val">${execution.jito_tip_lamports || 10000}</div>
            <div class="lbl">Jito Tip (Lamports)</div>
          </div>
          <div class="kpi-card">
            <div class="val">${invariants.max_slippage_bps || 500} bps</div>
            <div class="lbl">Max Slippage</div>
          </div>
          <div class="kpi-card">
            <div class="val" style="color:var(--accent);">${signals.length}</div>
            <div class="lbl">Outbox Signals</div>
          </div>
        </div>

        <div style="background:#11151c; border:1px solid var(--line); border-radius:6px; padding:12px;">
          <b style="font-size:12px; display:block; margin-bottom:8px; color:var(--accent);">🎯 TEST SNIPE SIMULATOR</b>
          <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
            <div style="flex:1; min-width:240px;" class="ctrl-group">
              <label class="ctrl-label">Solana Token Mint Address</label>
              <input type="text" id="snipe-test-mint" class="ctrl-input" placeholder="e.g. HYwLkDxZBqKt7AaTDy92qGqHFfSfTXWXbU4Y8VSxsons" value="HYwLkDxZBqKt7AaTDy92qGqHFfSfTXWXbU4Y8VSxsons">
            </div>
            <div style="width:120px;" class="ctrl-group">
              <label class="ctrl-label">Size (SOL)</label>
              <input type="number" id="snipe-test-size" class="ctrl-input" value="0.05" step="0.01" min="0.01" max="1.0">
            </div>
            <button class="btn-primary" id="btn-run-snipe-test" onclick="executeSnipeTest()">
              <span class="icon">🎯</span> Simulate Snipe
            </button>
          </div>
          <div id="snipe-test-result" style="display:none; margin-top:10px;"></div>
        </div>

        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <b style="font-size:13px;">EXECUTION SIGNALS OUTBOX (${signals.length})</b>
            <button class="btn-sm" onclick="openSniperModal()">⟳ Refresh Outbox</button>
          </div>
          <div style="max-height:240px; overflow-y:auto; border:1px solid var(--line); border-radius:6px;">
            <table class="pos-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Token</th>
                  <th>Side</th>
                  <th>Size</th>
                  <th>Score</th>
                  <th>Status</th>
                  <th>Tx Hash / Bundle ID</th>
                  <th>Created</th>
                </tr>
              </thead>
              <tbody>
                ${signals.length ? signals.map(s => {
                  const statusClass = s.status === 'CONFIRMED' || s.status === 'SUBMITTED' ? 'var(--ok)' : s.status === 'SIMULATED' ? 'var(--accent)' : s.status === 'PENDING' ? 'var(--warn)' : 'var(--alarm)';
                  const createdDate = s.created_at ? new Date(s.created_at * 1000).toLocaleTimeString() : '-';
                  return `
                    <tr>
                      <td class="dim">#${s.id}</td>
                      <td><b>${s.symbol || '?'}</b> <div class="dim" style="font-size:10px;">${(s.token_key || '').split(':')[1] || s.token_key}</div></td>
                      <td><b>${s.side}</b></td>
                      <td>${(s.size_native || 0).toFixed(4)} SOL</td>
                      <td>${(s.score || 0).toFixed(3)}</td>
                      <td><span style="color:${statusClass}; font-weight:700;">${s.status}</span></td>
                      <td style="font-family:monospace; font-size:11px;">${s.tx_hash ? s.tx_hash.slice(0, 16) + '...' : '<span class="dim">-</span>'}</td>
                      <td class="dim">${createdDate}</td>
                    </tr>
                  `;
                }).join('') : '<tr><td colspan="8" class="dim" style="text-align:center; padding:16px;">No execution signals in outbox. Run a sweep or sniper test to generate signals.</td></tr>'}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    `;

    showActionModal('🎯 Adversarial Sniper Telemetry & Outbox', html, false, 'modal-xl');
    updateBadges();
  } catch (err) {
    showActionModal('Sniper Info Error', `<p style="color:var(--alarm);">Network error: ${err.message}</p>`, false, 'modal-lg');
  }
}

async function executeSnipeTest() {
  const mint = document.getElementById('snipe-test-mint').value.trim();
  const size = parseFloat(document.getElementById('snipe-test-size').value) || 0.05;
  const resBox = document.getElementById('snipe-test-result');
  const btn = document.getElementById('btn-run-snipe-test');

  if (!mint) {
    alert('Please enter a valid Solana mint address.');
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="action-spinner"></span> Simulating...';
  resBox.style.display = 'block';
  resBox.innerHTML = '<p class="dim"><span class="action-spinner"></span> Querying bonding curve state, checking safety vetoes & simulating fill latency...</p>';

  try {
    const res = await fetch('/api/v1/sniper/test_snipe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mint: mint, size_sol: size }),
    });
    const data = await safeFetchJson(res);
    if (!res.ok) {
      resBox.innerHTML = `<p style="color:var(--alarm);">Snipe Test Failed: ${data.detail || 'Error'}</p>`;
      return;
    }

    const fill = data.simulated_fill || {};
    resBox.innerHTML = `
      <div style="background:#090d14; border:1px solid var(--line); border-radius:6px; padding:10px; margin-top:8px;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <b style="color:var(--ok);">✓ Modelled Snipe Receipt (${data.duration_seconds}s)</b>
          <span class="tag ok" style="color:var(--ok); font-weight:700;">${fill.rejected ? 'REJECTED' : 'SIMULATED FILL'}</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:8px; margin-top:8px; font-size:11px;">
          <div><span class="dim">Tokens Out:</span> <b>${Number(fill.amount_token || 0).toLocaleString()}</b></div>
          <div><span class="dim">Effective Price:</span> <b>${(fill.effective_price_sol || 0).toFixed(10)} SOL</b></div>
          <div><span class="dim">Simulated Slippage:</span> <b>${(fill.slippage_bps || 0).toFixed(1)} bps</b></div>
          <div><span class="dim">Modelled Latency:</span> <b>${(fill.latency_ms || 0).toFixed(1)} ms</b></div>
          <div><span class="dim">Priority + Tip:</span> <b>${((fill.fee_sol || 0) + (fill.tip_sol || 0)).toFixed(6)} SOL</b></div>
        </div>
        ${fill.reject_reason ? `<div style="color:var(--alarm); margin-top:6px; font-size:11px;">Reject Reason: ${fill.reject_reason}</div>` : ''}
      </div>
    `;
  } catch (err) {
    resBox.innerHTML = `<p style="color:var(--alarm);">Error: ${err.message}</p>`;
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<span class="icon">🎯</span> Simulate Snipe';
  }
}

// --- Live Badges Telemetry --- //
async function updateBadges() {
  try {
    const [portRes, snipRes] = await Promise.all([
      fetch('/api/v1/papertrade/portfolio'),
      fetch('/api/v1/sniper/status'),
    ]);
    if (portRes.ok) {
      const pData = await safeFetchJson(portRes);
      const badge = document.getElementById('open-positions-badge');
      if (badge) badge.innerText = pData.open_positions_count || 0;
    }
    if (snipRes.ok) {
      const sData = await safeFetchJson(snipRes);
      const badge = document.getElementById('sniper-signals-badge');
      if (badge) badge.innerText = (sData.outbox && sData.outbox.total_recorded_signals) || 0;
    }
  } catch (e) {}
}
setInterval(updateBadges, 15000);
updateBadges();

window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeActionModal();
  }
});
</script>

