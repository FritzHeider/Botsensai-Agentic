// Forensic Autopsy Fetcher
async function loadAutopsyTape(mint) {
  const container = document.getElementById('autopsy-container');
  container.innerHTML = '<div class="dim">Reconstructing forensic event tape...</div>';
  try {
    const res = await fetch(`/api/tokens/${mint}/autopsy`);
    const data = await res.json();
    if (!data.events || data.events.length === 0) {
      container.innerHTML = '<div class="dim">No telemetry events recorded yet.</div>';
      return;
    }

    container.innerHTML = `
      <div class="timeline-tape">
        ${data.events.map(e => {
          const s = e.elapsed_seconds;
          const timeStr = s < 60 ? `+${Math.round(s)}s` : `+${(s / 60).toFixed(1)}m`;
          return `
            <div class="timeline-event ${e.impact}">
              <div class="timeline-headline">${e.headline} <span class="dim" style="font-size:10px;">(${timeStr})</span></div>
              <div class="timeline-detail">${e.detail}</div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  } catch(e) {
    container.innerHTML = '<div class="dim">Unable to retrieve autopsy timeline.</div>';
  }
}

