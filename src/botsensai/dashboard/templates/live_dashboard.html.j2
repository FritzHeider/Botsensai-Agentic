<!doctype html>
<html lang="en" data-mode="{{ snap.mode }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Botsensai Live — {{ snap.trading_mode }}</title>
<style>
:root {
  --bg: #0a0c10;
  --panel: #11151c;
  --panel-hover: #161b24;
  --line: #222936;
  --text: #e2e8f0;
  --dim: #798699;
  --accent: #38bdf8;
  --ok: #22c55e;
  --warn: #eab308;
  --alarm: #ef4444;
  --glass: rgba(17, 21, 28, 0.85);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}
header {
  border-bottom: 1px solid var(--line);
  padding: 12px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  background: var(--panel);
  position: sticky;
  top: 0;
  z-index: 100;
}
.brand-group { display: flex; align-items: center; gap: 12px; }
.brand { font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--accent); font-size: 15px; }
.status-pill {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(34, 197, 94, 0.15); color: var(--ok);
  padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;
  border: 1px solid rgba(34, 197, 94, 0.3);
}
.pulse-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.stats-banner { color: var(--warn); font-weight: 600; font-size: 12px; letter-spacing: .05em; }
main {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1.2fr);
  gap: 20px;
  padding: 20px;
}
@media (max-width: 1080px) { main { grid-template-columns: 1fr; } }
section {
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 6px;
  margin-bottom: 20px;
  overflow: hidden;
}
h2 {
  margin: 0;
  padding: 10px 14px;
  border-bottom: 1px solid var(--line);
  font-size: 12px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--dim);
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.body { padding: 12px 14px; }
table { width: 100%; border-collapse: collapse; }
th {
  text-align: left;
  color: var(--dim);
  font-weight: 600;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
  padding: 8px;
  border-bottom: 1px solid var(--line);
}
td { padding: 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr:last-child td { border-bottom: 0; }
tr.clickable { cursor: pointer; transition: background .15s; }
tr.clickable:hover { background: var(--panel-hover); }
tr.selected { background: rgba(56, 189, 248, 0.1); border-left: 2px solid var(--accent); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.score-badge {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 700;
  font-size: 11px;
}
.score-high { background: rgba(34, 197, 94, 0.2); color: var(--ok); border: 1px solid var(--ok); }
.score-mid { background: rgba(234, 179, 8, 0.2); color: var(--warn); border: 1px solid var(--warn); }
.score-low { background: rgba(239, 68, 68, 0.2); color: var(--alarm); border: 1px solid var(--alarm); }
.veto { color: var(--alarm); font-weight: 600; }
.dim { color: var(--dim); }
.radar-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10px;
}
.radar-svg { width: 280px; height: 280px; }
.flag { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); }
.flag:last-child { border-bottom: 0; }
.dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex: none; }
.dot.ok { background: var(--ok); }
.dot.warn { background: var(--warn); }
.dot.alarm { background: var(--alarm); }
.ticker-feed {
  max-height: 240px;
  overflow-y: auto;
  font-size: 11px;
}
.ticker-item {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid var(--line);
}
.ticker-item:last-child { border-bottom: 0; }
.controls { display: flex; gap: 10px; margin-bottom: 12px; }
.search-input {
  background: var(--bg);
  border: 1px solid var(--line);
  color: var(--text);
  padding: 6px 10px;
  border-radius: 4px;
  font: inherit;
  font-size: 12px;
  flex: 1;
}
footer {
  padding: 12px 20px;
  color: var(--dim);
  border-top: 1px solid var(--line);
  font-size: 11px;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}
</style>
</head>
<body>
<header>
  <div class="brand-group">
    <span class="brand">Botsensai 2.0</span>
    <span class="status-pill" id="live-status"><span class="pulse-dot"></span> LIVE STREAM</span>
  </div>
  <div class="stats-banner">
    {{ snap.trading_mode|upper }} &middot; {{ snap.labelled_outcomes }} LABELLED OUTCOMES &middot; {{ snap.weights_version }}
  </div>
  <div class="dim" id="clock">
    {{ snap.generated_at.strftime('%Y-%m-%d %H:%M:%SZ') }}
  </div>
</header>

<main>
  <div>
    <section>
      <h2>
        <span>Live Candidates</span>
        <span class="dim" style="font-size:11px;" id="candidate-count">{{ snap.candidates|length }} tokens</span>
      </h2>
      <div class="body">
        <div class="controls">
          <input type="text" id="token-filter" class="search-input" placeholder="Search ticker or address...">
        </div>
        <table id="candidate-table">
          <thead>
            <tr>
              <th>Token</th>
              <th class="num">Score</th>
              <th class="num">Coverage</th>
              <th>Status / Veto</th>
            </tr>
          </thead>
          <tbody id="candidate-tbody">
            {% for c in snap.candidates %}
            <tr class="clickable" onclick="selectCandidate('{{ c.token_key }}', {{ c.composite }}, '{{ c.symbol }}')">
              <td><strong>{{ c.symbol }}</strong></td>
              <td class="num">
                <span class="score-badge {% if c.composite >= 0.68 %}score-high{% elif c.composite >= 0.5 %}score-mid{% else %}score-low{% endif %}">
                  {{ '%.3f'|format(c.composite) }}
                </span>
              </td>
              <td class="num">{{ (c.coverage * 100)|round|int }}%</td>
              <td>
                {% if c.vetoes %}<span class="veto">{{ c.vetoes|join(', ') }}</span>
                {% elif c.refused %}<span class="dim">refused &mdash; below floor</span>
                {% else %}<span style="color:var(--ok);font-weight:600;">eligible</span>{% endif %}
              </td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="dim">No active candidates. Run discovery sweep.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Live Discovery & Mint Firehose</h2>
      <div class="body">
        <div class="ticker-feed" id="ticker-feed">
          <div class="dim" style="padding:4px 0;">Listening on PumpPortal WebSocket stream...</div>
        </div>
      </div>
    </section>
  </div>

  <div>
    <section>
      <h2>Signal Radar Breakdown</h2>
      <div class="body">
        <div style="text-align:center; font-weight:600; margin-bottom:8px;" id="radar-title">Active Universe Average</div>
        <div class="radar-container">
          <svg class="radar-svg" viewBox="0 0 280 280" id="radar-svg">
            <!-- Polygon grid rings -->
            <polygon points="140,40 226,90 226,190 140,240 54,190 54,90" fill="none" stroke="var(--line)" stroke-width="1"/>
            <polygon points="140,70 200,105 200,175 140,210 80,175 80,105" fill="none" stroke="var(--line)" stroke-width="1"/>
            <polygon points="140,100 174,120 174,160 140,180 106,160 106,120" fill="none" stroke="var(--line)" stroke-width="1"/>
            <!-- Axis lines -->
            <line x1="140" y1="140" x2="140" y2="40" stroke="var(--line)" stroke-dasharray="2,2"/>
            <line x1="140" y1="140" x2="226" y2="90" stroke="var(--line)" stroke-dasharray="2,2"/>
            <line x1="140" y1="140" x2="226" y2="190" stroke="var(--line)" stroke-dasharray="2,2"/>
            <line x1="140" y1="140" x2="140" y2="240" stroke="var(--line)" stroke-dasharray="2,2"/>
            <line x1="140" y1="140" x2="54" y2="190" stroke="var(--line)" stroke-dasharray="2,2"/>
            <line x1="140" y1="140" x2="54" y2="90" stroke="var(--line)" stroke-dasharray="2,2"/>
            <!-- Dynamic Data Polygon -->
            <polygon id="radar-data-poly" points="140,65 210,100 195,170 140,205 75,180 85,100" fill="rgba(56,189,248,0.25)" stroke="var(--accent)" stroke-width="2"/>
            <!-- Labels -->
            <text x="140" y="30" fill="var(--dim)" font-size="10" text-anchor="middle">Topology</text>
            <text x="235" y="88" fill="var(--dim)" font-size="10" text-anchor="start">Social</text>
            <text x="235" y="195" fill="var(--dim)" font-size="10" text-anchor="start">Community</text>
            <text x="140" y="255" fill="var(--dim)" font-size="10" text-anchor="middle">Narrative</text>
            <text x="45" y="195" fill="var(--dim)" font-size="10" text-anchor="end">Credibility</text>
            <text x="45" y="88" fill="var(--dim)" font-size="10" text-anchor="end">Execution</text>
          </svg>
        </div>
      </div>
    </section>

    <section>
      <h2>System & Integrity Sentinel</h2>
      <div class="body">
        {% for f in snap.integrity %}
        <div class="flag">
          <span class="dot {{ f.level }}"></span>
          <div>
            <strong>{{ f.headline }}</strong><br>
            <span class="dim">{{ f.detail }}</span>
          </div>
        </div>
        {% else %}
        <div class="dim">Integrity checks green. Store healthy.</div>
        {% endfor %}
      </div>
    </section>
  </div>
</main>

<footer>
  <span>Botsensai 2.0 Real-Time Dashboard &middot; Point-in-Time Safe</span>
  <span class="dim">No real money signing capability &middot; Paper Mode Enforced</span>
</footer>

<script>
let ws;
function connectWS() {
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const wsUrl = `${protocol}//${window.location.host}/ws/live`;
  ws = new WebSocket(wsUrl);

  ws.onopen = () => {
    document.getElementById('live-status').innerHTML = '<span class="pulse-dot"></span> LIVE STREAM';
  };

  ws.onmessage = (event) => {
    try {
      const msg = JSON.parse(event.data);
      if (msg.type === 'mint_discovered') {
        addTickerItem(`🚀 New Mint: $${msg.data.symbol || '?'} (${msg.data.mint.slice(0,8)}...)`, msg.timestamp);
      } else if (msg.type === 'candidate_scored') {
        addTickerItem(`📊 Scored $${msg.data.symbol}: ${Number(msg.data.score).toFixed(3)}`, msg.timestamp);
      }
    } catch (err) {}
  };

  ws.onclose = () => {
    document.getElementById('live-status').innerHTML = '<span class="pulse-dot" style="background:var(--alarm)"></span> RECONNECTING';
    setTimeout(connectWS, 3000);
  };
}

function addTickerItem(text, ts) {
  const feed = document.getElementById('ticker-feed');
  const div = document.createElement('div');
  div.className = 'ticker-item';
  const timeStr = ts ? new Date(ts).toLocaleTimeString() : new Date().toLocaleTimeString();
  div.innerHTML = `<span>${text}</span><span class="dim">${timeStr}</span>`;
  feed.prepend(div);
  if (feed.children.length > 20) feed.removeChild(feed.lastChild);
}

function selectCandidate(tokenKey, composite, symbol) {
  document.getElementById('radar-title').innerText = `$${symbol} Signal Profile (${composite.toFixed(3)})`;
  // Modulate polygon for visualization
  const factor = Math.max(0.3, Math.min(1.0, composite));
  const cx = 140, cy = 140, r = 90 * factor;
  const p1 = `${cx},${cy - r}`;
  const p2 = `${cx + r * 0.866},${cy - r * 0.5}`;
  const p3 = `${cx + r * 0.866},${cy + r * 0.5}`;
  const p4 = `${cx},${cy + r}`;
  const p5 = `${cx - r * 0.866},${cy + r * 0.5}`;
  const p6 = `${cx - r * 0.866},${cy - r * 0.5}`;
  document.getElementById('radar-data-poly').setAttribute('points', `${p1} ${p2} ${p3} ${p4} ${p5} ${p6}`);
}

connectWS();
</script>
</body>
</html>
