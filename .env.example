# =========================================================================== #
# Botsensai Environment Configuration Template (.env)
# =========================================================================== #
# Copy this file to `.env` in the repository root or export variables in your shell.
# All settings in config/botsensai.yaml can be overridden using BOTSENSAI_ prefix.
# Nested settings use double underscores (e.g. BOTSENSAI_RISK__MAX_POSITION_NATIVE).

# --- CORE SETTINGS --------------------------------------------------------- #
# Trading mode: paper (recommended default) | backtest | live
BOTSENSAI_TRADING_MODE=paper
BOTSENSAI_DRY_RUN=true
BOTSENSAI_LOG_LEVEL=INFO
BOTSENSAI_LOG_JSON=false
BOTSENSAI_DB_PATH=data/botsensai.db
BOTSENSAI_SEED=1337

# --- SOLANA RPC & API KEYS ------------------------------------------------- #
# Solana RPC Endpoint (standard rate-limited public RPC by default)
BOTSENSAI_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BOTSENSAI_SOLANA_WS_URL=

# Helius RPC API Key (unlocks deployer history, deep funding analysis, on-chain topology)
# Get a free key at: https://helius.dev
# BOTSENSAI_HELIUS_API_KEY=your_helius_api_key_here

# Birdeye API Key (unlocks token security audits, holder rankings)
# Get a key at: https://birdeye.so
# BOTSENSAI_BIRDEYE_API_KEY=your_birdeye_api_key_here

# Bitquery API Key (optional DEX & token transfers graph)
# BOTSENSAI_BITQUERY_API_KEY=your_bitquery_api_key_here

# Jito Block Engine URL (for sub-second bundle simulation)
# BOTSENSAI_JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- SOCIAL CREDENTIALS (OPTIONAL) ----------------------------------------- #
# All social collectors degrade gracefully without API keys.
# BOTSENSAI_X_BEARER_TOKEN=
# BOTSENSAI_REDDIT_CLIENT_ID=
# BOTSENSAI_REDDIT_CLIENT_SECRET=
# BOTSENSAI_TELEGRAM_API_ID=
# BOTSENSAI_TELEGRAM_API_HASH=
# BOTSENSAI_YOUTUBE_API_KEY=

# --- NOTIFICATIONS & WEBHOOKS ---------------------------------------------- #
# Receive instant alerts for candidate scores >= threshold, paper trade fills, and alarms.
# BOTSENSAI_NOTIFICATIONS__ENABLED=true
# BOTSENSAI_NOTIFICATIONS__DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# BOTSENSAI_NOTIFICATIONS__TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# BOTSENSAI_NOTIFICATIONS__TELEGRAM_CHAT_ID=123456789

# --- RISK PARAMETERS (SOL) ------------------------------------------------- #
# Maximum position size in native SOL (default: 0.25 SOL)
# BOTSENSAI_RISK__MAX_POSITION_NATIVE=0.25
# BOTSENSAI_RISK__MAX_PORTFOLIO_EXPOSURE_NATIVE=2.0
# BOTSENSAI_RISK__MAX_CONCURRENT_POSITIONS=8
# BOTSENSAI_RISK__MAX_DAILY_LOSS_NATIVE=1.0
# BOTSENSAI_RISK__STOP_LOSS_PCT=0.45

# --- X BROWSER PROFILE (SESSION COLLECTION) -------------------------------- #
# Run `botsensai x-setup` to configure this safely.
# BOTSENSAI_BROWSER__USER_DATA_DIR=/Users/youruser/botsensai-x-profile
# BOTSENSAI_X_SESSION__ENABLED=false
# BOTSENSAI_X_SESSION__ACKNOWLEDGED_BURNER=false
