# ============================================================================ #
# Botsensai Production Environment Variables (Ubuntu EC2)
# ============================================================================ #

# Mode configuration
BOTSENSAI_TRADING_MODE=paper
BOTSENSAI_LOG_JSON=false
BOTSENSAI_LOG_LEVEL=INFO

# Paths
BOTSENSAI_CONFIG=/home/ubuntu/botsensai/config/botsensai.yaml
BOTSENSAI_DB_PATH=/home/ubuntu/botsensai/data/botsensai.db

# API Keys & RPC Endpoints (never commit actual secrets)
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# S3 Backup bucket name
BOTSENSAI_BACKUP_S3_BUCKET=
