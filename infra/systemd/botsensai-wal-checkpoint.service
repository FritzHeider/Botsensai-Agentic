[Unit]
Description=Botsensai SQLite WAL Checkpoint and Vacuum Optimizer
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Botsensai
EnvironmentFile=-/home/ubuntu/Botsensai/.env
ExecStart=/home/ubuntu/Botsensai/.venv/bin/python scripts/wal_checkpoint.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
