__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
data/
!data/.gitkeep
.env
# Browser profiles hold live session cookies. They belong outside the repo, and
# these patterns are a second line of defence in case one lands inside it.
*-profile/
*chrome-profile*/
botsensai-x-profile/
*.db
*.db-wal
*.db-shm
.venv/

# ralph-orchestrator runtime state: locks, event logs, agent scratchpad.
.ralph/

# Coverage database. `scripts/backpressure.py` rewrites it on every run, so a
# tracked copy is a binary that changes on every check and means nothing.
.coverage
.coverage.*
.worktrees/
